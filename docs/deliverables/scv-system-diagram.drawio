ry"/></mxCell><mxCell id="p6-n8" value="&lt;div style=&#x27;font-size:8px;color:#5B4BA6&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;/tasks  작업·로봇&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;SELECT tasks WHERE run_id = 지금 run&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;갱신: ch:tasks · robot:{rid}:state&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;열: task_id · type · robot · status · progress&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F4F1FA;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p6-1"><mxGeometry x="2199.5" y="635.5" width="261.0" height="69.0" as="geometry"/></mxCell><mxCell id="p6-n9" value="&lt;div style=&#x27;font-size:8px;color:#5B4BA6&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;/cam  CAM&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;탭을 열 때만 IF-14 구독 시작&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;탭을 떠나면 구독 해제 (대역폭)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;로봇 선택: robot4 | robot3&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F4F1FA;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p6-1"><mxGeometry x="2251.0" y="544.5" width="158.0" height="69.0" as="geometry"/></mxCell><mxCell id="p6-n10" value="&lt;div style=&#x27;font-size:8px;color:#5B4BA6&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;/inspections  점검 이력&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;SELECT inspections JOIN media ORDER BY inspected_at DESC&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;갱신: ch:inspections&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;셔터 SHT-01·02 는 한 줄로 묶어 표시&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F4F1FA;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p6-1"><mxGeometry x="2172.5" y="453.5" width="315.0" height="69.0" as="geometry"/></mxCell><mxCell id="p6-n11" value="&lt;div style=&#x27;font-size:8px;color:#5B4BA6&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;/events  이벤트&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;SELECT robot_events ORDER BY ts DESC LIMIT 100&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;갱신: ch:events&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;확정 이상(findings) 「확인」 버튼 (admin)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F4F1FA;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p6-1"><mxGeometry x="2199.0" y="283.5" width="262.0" height="69.0" as="geometry"/></mxCell><mxCell id="p6-n12" value="&lt;div style=&#x27;font-size:8px;color:#5B4BA6&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;/reports  보고서&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;SELECT reports WHERE run_id&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;「보고서 만들기」 → 파일 → 다운로드&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F4F1FA;strokeColor=#5B4BA6;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p6-1"><mxGeometry x="2238.5" y="374.5" width="183.0" height="57.0" as="geometry"/></mxCell><mxCell id="p6-n13" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;/settings  설정&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if session.role != &#x27;admin&#x27;: 403&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;SELECT settings · 폼 → UPDATE settings&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p6-1"><mxGeometry x="2220.5" y="204.5" width="219.0" height="57.0" as="geometry"/></mxCell><mxCell id="p6-n14" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;POST /api/run/start (admin)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;call /inspection/start (std_srvs/Trigger)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;res.success → 토스트 「run_id=…」 · 실패 → res.message&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p6-1"><mxGeometry x="2183.5" y="854.5" width="293.0" height="57.0" as="geometry"/></mxCell><mxCell id="p6-n15" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;POST /api/estop&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;call /inspection/estop (Trigger) — 역할 관계없이&lt;/div&gt;&lt;/div&gt;" style="rounded=0;das