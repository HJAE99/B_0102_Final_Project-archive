FFFFF;" edge="1" parent="p0-1" source="p0-n17" target="p0-n16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2109.7" y="1013.3"/><mxPoint x="2151.0" y="937.6"/><mxPoint x="2118.2" y="843.0"/></Array></mxGeometry></mxCell><mxCell id="p0-e36" value="SUBSCRIBE → WebSocket push" style="endArrow=block;endFill=1;html=1;curved=1;strokeColor=#2B6A55;strokeWidth=1.5;dashed=1;fontFamily=monospace;fontSize=9;fontColor=#2B6A55;labelBackgroundColor=#FFFFFF;" edge="1" parent="p0-1" source="p0-n18" target="p0-n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1879.9" y="905.3"/><mxPoint x="1963.0" y="892.5"/><mxPoint x="2167.1" y="840.6"/><mxPoint x="2126.7" y="725.3"/><mxPoint x="2003.1" y="671.3"/></Array></mxGeometry></mxCell><mxCell id="p0-e37" value="SELECT (페이지 열 때)" style="endArrow=block;endFill=1;html=1;curved=1;strokeColor=#8A6D1F;strokeWidth=1.5;dashed=1;fontFamily=monospace;fontSize=9;fontColor=#8A6D1F;labelBackgroundColor=#FFFFFF;" edge="1" parent="p0-1" source="p0-n18" target="p0-n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1831.2" y="962.1"/><mxPoint x="1912.4" y="1011.3"/></Array></mxGeometry></mxCell><mxCell id="p0-e38" value="POST /api/run/start · /api/estop&lt;br&gt;HTTP JSON" style="endArrow=block;endFill=1;html=1;curved=1;strokeColor=#2B6A55;strokeWidth=1.5;dashed=1;fontFamily=monospace;fontSize=9;fontColor=#2B6A55;labelBackgroundColor=#FFFFFF;" edge="1" parent="p0-1" source="p0-n19" target="p0-n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1984.2" y="961.0"/><mxPoint x="1998.0" y="1003.1"/></Array></mxGeometry></mxCell><mxCell id="p0-e39" value="HTTP · WebSocket&lt;br&gt;로그인 세션" style="endArrow=block;endFill=1;startArrow=block;startFill=1;html=1;curved=1;strokeColor=#2B6A55;strokeWidth=1.5;dashed=1;fontFamily=monospace;fontSize=9;fontColor=#2B6A55;labelBackgroundColor=#FFFFFF;" edge="1" parent="p0-1" source="p0-n20" target="p0-n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p0-e40" value="IF-14 CompressedImage (CAM 탭 열 때만)" style="endArrow=block;endFill=1;html=1;curved=1;strokeColor=#0B7A84;strokeWidth=1.8;dashed=1;fontFamily=monospace;fontSize=9;fontColor=#0B7A84;labelBackgroundColor=#FFFFFF;" edge="1" parent="p0-1" source="p0-n21" target="p0-n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2409.5" y="961.6"/><mxPoint x="2280.2" y="1021.3"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s1" name="1 AMR · mission_executor"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3343" pageHeight="2137" math="0" shadow="0"><root><mxCell id="p1-0"/><mxCell id="p1-1" parent="p1-0"/><mxCell id="p1-n0" value="main() — 시작" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#2F5D7C;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#2F5D7C;" vertex="1" parent="p1-1"><mxGeometry x="8.0" y="634.0" width="326.0" height="662.0" as="geometry"/></mxCell><mxCell id="p1-n1" value="상태 입력 → 상태 출력 (IF-12)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#2F5D7C;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#2F5D7C;" vertex="1" parent="p1-1"><mxGeometry x="1924.0" y="112.0" width="631.0" height="221.0" as="geometry"/></mxCell><mxCell id="p1-n2" value="작업 실행 — IF-11 {ns}/execute_task 액션 서버" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#2F5D7C;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#2F5D7C;" vertex="1" parent="p1-1"><mxGeometry x="556.0" y="479.0" width="2492.0" height="1524.0" as="geometry"/></mxCell><mxCell id="p1-n3" value="follow(gh, waypoints, precise) · follow_loop()" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#2F5D7C;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#2F5D7C;" vertex="1" parent="p1-1"><mxGeometry x="1801.0" y="864.0" width="779.0" height="687.0" as="geometry"/></mxCell><mxCell id="p1-n4" value="inspect(gh, g) — FACILITY_CHECK" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8E5600;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#8E5600;" vertex="1" parent="p1-1"><mxGeometry x="570.0" y="1327.0" width="677.0" height="490.0" as="geometry"/></mxCell><mxCell id="p1-n5" value="measure(gh) — REINSPECTION" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#0B7A84;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#0B7A84;" vertex="1" parent="p1-1"><mxGeometry x="1401.0" y="1344.0" width="386.0" height="393.0" as="geometry"/></mxCell><mxCell id="p1-n6" value="go_dock(gh, waypoints) — DOCK · 배터리" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#2F5D7C;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#2F5D7C;" vertex="1" parent="p1-1"><mxGeometry x="2594.0" y="870.0" width="440.0" height="186.0" as="geometry"/></mxCell><mxCell id="p1-n7" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;nav = TurtleBot4Navigator()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;xyyaw = [declare_parameter(k, nan) for k in x,y,yaw]&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="24.0" y="670.0" width="294.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n8" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;if any(isnan(v) for v in xyyaw):&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;xyyaw = HOME[ns]&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;HOME[&#x27;/robot4&#x27;] = (2.863, 0.948, 175.8°)&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;HOME[&#x27;/robot3&#x27;] = (2.855, 4.656, 176.7°)  (Dock 바로 앞)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="47.0" y="760.0" width="248.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n9" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;if nav.getDockedStatus():  → nav.undock()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="22.5" y="911.0" width="297.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n10" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;nav.setInitialPose(home)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;nav.waitUntilNav2Active()&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;Dock 에서는 lidar 가 꺼져 있어 HOME 을 초기 위치로&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="80.0" y="1001.0" width="222.0" height="46.0" as="geometry"/></mxCell><mxCell id="p1-n11" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;node = MissionExecutor(nav, home)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;MultiThreadedExecutor.spin (스레드)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="69.5" y="1104.0" width="243.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n12" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;while ok: (0.5 s)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if not busy and battery &amp;lt;= 15.0&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;   and state != STATE_DOCKED:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;     go_dock(None, [])   # E2&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;self.battery ← on_battery()&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="99.5" y="1212.0" width="183.0" height="70.0" as="geometry"/></mxCell><mxCell id="p1-n13" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_battery(msg: BatteryState)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;self.battery = msg.percentage * 100.0  # float 0–100&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2247.0" y="159.0" width="294.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n14" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_pose(msg: PoseWithCovarianceStamped)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;yaw = atan2(2(wz+xy), 1-2(y²+z²))&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;std = sqrt(max(cov[0], cov[7], 0))&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;self.pose = (x, y, yaw, std)  # tuple[float×4]&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1938.0" y="148.0" width="284.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n15" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;publish_status()  ← timer 1.0 s&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;accepting_tasks = battery &amp;gt; 30.0&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;pose_ok = pose[3] &amp;lt;= pose_std_max (0.15 m)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;task_id, run_id, task_type ← self.task&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;state ∈ IDLE·EXECUTING·BLOCKED·DOCKING·DOCKED&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2057.5" y="249.0" width="257.0" height="70.0" as="geometry"/></mxCell><mxCell id="p1-n16" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_goal(goal) → GoalResponse&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;self.battery ← on_battery()&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if busy or (battery &amp;lt;= 30.0&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;           and goal.type != DOCK):&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    return REJECT&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;busy = True; return ACCEPT&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2081.0" y="515.0" width="210.0" height="82.0" as="geometry"/></mxCell><mxCell id="p1-n17" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;execute(gh): g = gh.request&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if state == STATE_DOCKED and g.type != DOCK:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    nav.undock(); nav.setInitialPose(home)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;state = STATE_EXECUTING&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2060.0" y="659.0" width="252.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n18" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;match g.type:&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;SURVEY_SEGMENT=0 · FACILITY_CHECK=1&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;REINSPECTION=2 · DOCK=3 · 그 외 → &#x27;UNKNOWN_TYPE&#x27;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2051.5" y="766.0" width="269.0" height="46.0" as="geometry"/></mxCell><mxCell id="p1-n19" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;finally:&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if reason == &#x27;LOW_BATTERY&#x27;: go_dock(gh, [])&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;task, busy = None, False&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;state = IDLE if state != DOCKED&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;gh.canceled() | gh.succeed() | gh.abort()&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1253.0" y="1854.0" width="246.0" height="70.0" as="geometry"/></mxCell><mxCell id="p1-n20" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;return ExecuteTask.Result(ok: bool, reason: str,&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  rssi_median: float32, rssi_iqr: float32, n_samples: uint16)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1203.5" y="1953.0" width="345.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n21" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;if not waypoints:&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    return (False, &#x27;NO_WAYPOINTS&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if precise: set_tolerance(0.05, 0.087)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;finally: set_tolerance(0.10, 0.17)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1832.0" y="900.0" width="220.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n22" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;nav.goThroughPoses(waypoints)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;last_xy, last_t = None, time()&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1834.0" y="1006.0" width="216.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n23" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;while not nav.isTaskComplete():  (0.2 s)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if gh.is_cancel_requested or battery &amp;lt;= 15.0:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    nav.cancelTask(); stop()&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    return (False, &#x27;CANCELED&#x27; | &#x27;LOW_BATTERY&#x27;)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1814.5" y="1093.0" width="291.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n24" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;fb = nav.getFeedback()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;i = done + len(wp) - fb.number_of_poses_remaining&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;progress = i / n&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;gh.publish_feedback(ExecuteTask.Feedback(i, progress))&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2072.0" y="1218.0" width="304.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n25" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;막힘 판정 (E1)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if dist(xy, last_xy) &amp;gt; 0.05: last_t = now&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;elif now - last_t &amp;gt; 10.0: break  → 건너뜀&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;elif now - last_t &amp;gt; 5.0: state = BLOCKED&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2106.0" y="1369.0" width="236.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n26" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;건너뜀: nav.cancelTask()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;k = len(wp) - fb.number_of_poses_remaining&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;waypoints = waypoints[k+1:]; skipped += 1&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="2103.5" y="1491.0" width="241.0" height="46.0" as="geometry"/></mxCell><mxCell id="p1-n27" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;res = nav.getResult()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if res == TaskResult.SUCCEEDED:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    (True, &#x27;&#x27;) if skipped == 0&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    else (False, f&#x27;BLOCKED skipped={n}&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else (False, str(res))&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1815.5" y="1212.0" width="231.0" height="70.0" as="geometry"/></mxCell><mxCell id="p1-n28" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;kind = KIND.get(g.target_ref[:3], 0)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;EXT→1 · SHT→2 · EXL→3&lt;/div&gt;&lt;div style=&#x27;color:#A33A2B;font-weight:bold&#x27;&gt;RCK(랙) 없음 → kind 0 으로 감&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;goal = InspectFacility.Goal(task_id, facility_id=target_ref, kind)&lt;/div&gt;&lt;div style=&#x27;color:#A33A2B;font-weight:bold&#x27;&gt;run_id 를 더 넣을 것 (Goal.run_id, v0.2.10 · 10/12 결정)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="698.5" y="1363.0" width="367.0" height="70.0" as="geometry"/></mxCell><mxCell id="p1-n29" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;call_action(inspect_cli, goal, gh, on_fb, each)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if not wait_for_server(5.0): (None,&#x27;NO_SERVER&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if not accepted: (None,&#x27;REJECTED&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if gh.is_cancel_requested: cancel → &#x27;CANCELED&#x27;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="648.0" y="1485.0" width="338.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n30" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;do_adjust(adjust)  # 피드백마다&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if f.adjust_yaw: nav.spin(f.adjust_yaw)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if f.adjust_forward_m &amp;gt; 0: nav.driveOnHeading(f.adjust_forward_m)&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;후진은 하지 않음 (뒤에 센서 없음)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="584.0" y="1745.0" width="362.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n31" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;ok = res.verdict != UNCONFIRMED&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;reason = f&#x27;verdict={res.verdict} {res.detail}&#x27;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="971.0" y="1756.0" width="262.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n32" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;goal = PreciseMeasure.Goal(duration_s=30)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;call_action(precise_cli, goal, gh)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1475.5" y="1380.0" width="297.0" height="36.0" as="geometry"/></mxCell><mxCell id="p1-n33" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;return (True, f&#x27;median={m:.1f} iqr={q:.1f} n={n}&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;color:#A33A2B;font-weight:bold&#x27;&gt;지금 코드는 측정값을 reason 문자열로만 보냄&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;10/12 결정 (interfaces v0.2.10): Result.rssi_median · rssi_iqr ·&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;  n_samples 에 PreciseMeasure 결과를 그대로 넣는다&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p1-1"><mxGeometry x="1415.0" y="1665.0" width="358.0" height="58.0" as="geometry"/></mxCell><mxCell id="p1-n34" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;if nav.getDockedStatus(): state = DOCKED; return (True,&#x27;&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;ok = follow(gh, wp) if wp else go_home()&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;go_home: nav.goToPose(home) → getResult()&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;str