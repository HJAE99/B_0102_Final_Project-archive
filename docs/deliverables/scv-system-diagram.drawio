8"/></Array></mxGeometry></mxCell><mxCell id="p1-e45" value="IF-11 Result → on_task_result()" style="endArrow=block;endFill=1;html=1;curved=1;strokeColor=#5B4BA6;strokeWidth=1.8;fontFamily=monospace;fontSize=9;fontColor=#5B4BA6;labelBackgroundColor=#FFFFFF;" edge="1" parent="p1-1" source="p1-n43" target="p1-n33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3075.1" y="1541.7"/><mxPoint x="2935.2" y="1611.1"/><mxPoint x="2583.5" y="1685.0"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s2" name="2 RSSI · rssi_scanner · survey_buffer · network_map_engine"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="2350" math="0" shadow="0"><root><mxCell id="p2-0"/><mxCell id="p2-1" parent="p2-0"/><mxCell id="p2-n0" value="rssi_scanner — 로봇 RPi&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;params: iface wlan0 · method scan · ssid_pattern &#x27;iPhone&#x27; · rate_hz 1.0 · rescan_after_miss 3 · full_scan_interval 10 s · scan_retries 2&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#0B7A84;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#0B7A84;" vertex="1" parent="p2-1"><mxGeometry x="1192.0" y="8.0" width="590.0" height="879.0" as="geometry"/></mxCell><mxCell id="p2-n1" value="survey_buffer — 로봇 PC&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;시제품 manual_tagger.py (pose_source=tf) · params max_pose_age 0.5 s · max_pose_cov 0.25 m²&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#0B7A84;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#0B7A84;" vertex="1" parent="p2-1"><mxGeometry x="1032.0" y="927.0" width="431.0" height="524.5" as="geometry"/></mxCell><mxCell id="p2-n2" value="network_map_engine — 관제 PC&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;params: cell_size 0.5 · miss_ratio_thresh 0.5 · shadow_dbm −72 · rssi_weak −75(색) · rssi_strong −35 · min_samples_for_mask 2 · mask_margin 0.0&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#0B7A84;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#0B7A84;" vertex="1" parent="p2-1"><mxGeometry x="8.0" y="13.0" width="759.0" height="2289.5" as="geometry"/></mxCell><mxCell id="p2-n3" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_timer()  ← timer 1/rate_hz (1.0 s)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if fatal: return&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if pending_ssid: tracker = HotspotTracker(ssid)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1498.0" y="52.0" width="270.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n4" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;freqs = tracker.next_freqs(monotonic())&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;list[int] MHz — 빈 리스트면 전체 대역(약 5 s)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1479.0" y="165.5" width="284.0" height="36.0" as="geometry"/></mxCell><mxCell id="p2-n5" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;res = run_iw_scan(iface, freqs)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;fresh = fresh_bss(res.bss, res.start_boottime, res.duration_s)&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;subprocess: iw dev wlan0 scan freq …&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1267.0" y="269.0" width="346.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n6" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;for _ in range(scan_retries=2):&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if not res.ok or match_ssid(fresh, ssid): break&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;res, fresh = scan_once(freqs)   # probe 응답 누락 대비&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1293.0" y="360.0" width="294.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n7" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;if not res.ok:&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if is_permission_error(res.error): fatal = True&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;return   # NetRaw 를 보내지 않음&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;미검출로 세면 멀쩡한 칸이 회색이 되므로&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1306.5" y="451.0" width="267.0" height="58.0" as="geometry"/></mxCell><mxCell id="p2-n8" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;tr = tracker.update(fresh, res.full, monotonic())&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;TrackResult(target: ScanBss|None, candidates, events)&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;target_ssid 비면 &#x27;iPhone&#x27; 든 AP 중 가장 센 것으로 고정&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1264.5" y="554.0" width="351.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n9" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;if tr.target is None:&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;publish(now, detected=False, rssi=None)&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;misses ≥ rescan_after_miss(3) → 채널 다시 찾기&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1327.5" y="645.0" width="225.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n10" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;rssi = int(round(t.signal_dbm))&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;age_s = res.end_boottime - t.seen_boottime&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;stamp = now - age_s   # 실제로 들은 시각&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1215.5" y="736.0" width="241.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n11" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;publish(stamp, detected, rssi)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;NetRaw(stamp, robot_id, detected: bool,&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;       rssi_dbm: int16 = rssi if detected else 0)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1206.0" y="827.0" width="278.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n12" value="&lt;div style=&#x27;font-size:8px;color:#0B7A84&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;PreciseMeasure 액션 서버&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;for duration_s: measure_scan() → list[int]&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;median = statistics.median(v)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;iqr = q3 - q1 · n = len(v)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;feedback elapsed_s: uint16&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1206.5" y="143.0" width="241.0" height="81.0" as="geometry"/></mxCell><mxCell id="p2-n13" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_raw(raw: NetRaw)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;tf 가 Wi-Fi 지연만큼 늦어 tf_wait 동안 기다림&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1223.5" y="971.0" width="193.0" height="36.0" as="geometry"/></mxCell><mxCell id="p2-n14" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;lookup_pose(raw.stamp, now)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;tf_buffer.lookup_transform(&#x27;map&#x27;, &#x27;base_link&#x27;, t_meas)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;→ (x, y, yaw, age_s, lag_s)   # 없으면 최근 TF&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1093.0" y="1062.5" width="304.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n15" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;pose_usable(age_s, cov_xy, 0.5, 0.25, lag_s) → (ok, why)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if age_s is None: (False, &#x27;TF 없음&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if |lag_s| &amp;gt; 0.5 or |age_s| &amp;gt; 0.5: False&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if cov_xy(=cov[0]+cov[7]) &amp;gt; 0.25: False&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1045.5" y="1153.5" width="399.0" height="58.0" as="geometry"/></mxCell><mxCell id="p2-n16" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;publish(raw, ok)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;seq += 1&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;NetSample(seq, stamp, robot_id, run_id, x, y, yaw,&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;          pose_ok=ok, resent=False, detected, rssi_dbm)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1067.5" y="1256.5" width="309.0" height="58.0" as="geometry"/></mxCell><mxCell id="p2-n17" value="&lt;div style=&#x27;font-size:8px;color:#0B7A84&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;버퍼·재전송&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;JSONL 추가 (로봇 PC 디스크)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;SyncSamples(run_id, from_seq) → resent=True 로 다시 발행&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;run_id ← RobotStatus.run_id&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="1069.0" y="1368.5" width="306.0" height="69.0" as="geometry"/></mxCell><mxCell id="p2-n18" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_map(m: OccupancyGrid)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;grid.set_map(origin.x, origin.y, width·res, height·res)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;map_info = m.info; publish_mask()   # 빈 마스크&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="444.5" y="160.5" width="309.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n19" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_sample(m: NetSample)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;s = Sample(robot_id, seq, x, y, pose_ok, detected, rssi_dbm)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="390.0" y="1385.0" width="336.0" height="36.0" as="geometry"/></mxCell><mxCell id="p2-n20" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;grid.add(s) → bool&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if (robot_id, seq) in _seen: return False   # 중복&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;_seen.add(key)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if not s.pose_ok: return False   # E5&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;_samples.append(s); return True&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="418.0" y="1489.5" width="280.0" height="70.0" as="geometry"/></mxCell><mxCell id="p2-n21" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_timer()  ← 1.0 s&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if dirty: pub.publish(build_markers())&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;칸 색 TRIANGLE_LIST + 중앙값 글자 + 샘플 점&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="448.0" y="1604.5" width="220.0" height="46.0" as="geometry"/></mxCell><mxCell id="p2-n22" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;grid.cells() → dict[(i, j), CellStats]&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;i = floor((x - ox) / 0.5) · j = floor((y - oy) / 0.5)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;detected → st.rssi.append(rssi_dbm)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else    → st.n_missed += 1&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="408.5" y="1695.5" width="299.0" height="58.0" as="geometry"/></mxCell><mxCell id="p2-n23" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;CellStats&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;median = statistics.median(rssi)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;miss_ratio = n_missed / n_total&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;n_total = len(rssi) + n_missed&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="463.5" y="1798.5" width="189.0" height="58.0" as="geometry"/></mxCell><mxCell id="p2-n24" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;cell_status(st) → &#x27;miss&#x27; | &#x27;shadow&#x27; | &#x27;normal&#x27;&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if n_detected == 0 or miss_ratio &amp;gt;= 0.5: MISS&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;elif median &amp;lt; shadow_dbm (−72): SHADOW&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else: NORMAL&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="392.5" y="1901.5" width="331.0" height="58.0" as="geometry"/></mxCell><mxCell id="p2-n25" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_finish()  ← ~/finish_survey (std_srvs/Trigger)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;keepout = keepout_cells(cells, −72, 0.5, min_samples=2)&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;n_total &amp;lt; 2 칸은 한 번 튄 값일 수 있어 뺌&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;survey_done = True; publish_mask()&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p2-1"><mxGeometry x="40.5" y="2004.5" width="351.0" height="58.0" as="geometry"/></mxCell><mxCell id="p2-n26" value="&lt;div style=&#x27;font-size:8px;color:#0B7A84&#x27;&gt;코드에 있음 · 10/12: 관제가 이 함수를 가져다 씀&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;keepout_mask(cells, 0.5, origin, res, w, h, margin)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;→ list[int] (행 우선, 100 = KEEPOUT, 0)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;OccupancyGrid(info = map_info, data)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=