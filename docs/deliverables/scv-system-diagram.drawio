nospace;fontSize=9;fontColor=#2B6A55;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2-1" source="p2-n32" target="p2-n14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020.6" y="1015.6"/><mxPoint x="1066.7" y="1031.4"/><mxPoint x="1131.9" y="1051.8"/></Array></mxGeometry></mxCell><mxCell id="p2-e33" value="IF-15 /inspection/candidates · scv_msgs/Candidate" style="endArrow=block;endFill=1;html=1;curved=1;strokeColor=#0B7A84;strokeWidth=1.8;dashed=1;fontFamily=monospace;fontSize=9;fontColor=#0B7A84;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2-1" source="p2-n33" target="p2-n18"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="863.7" y="108.3"/><mxPoint x="820.0" y="145.5"/></Array></mxGeometry></mxCell><mxCell id="p2-e34" value="" style="endArrow=block;endFill=1;html=1;curved=1;strokeColor=#33414B;strokeWidth=1.1;dashed=1;fontFamily=monospace;fontSize=9;fontColor=#33414B;labelBackgroundColor=#FFFFFF;" edge="1" parent="p2-1" source="p2-n34" target="p2-n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="s3" name="3 Detection · detection_alert"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1262" pageHeight="1611" math="0" shadow="0"><root><mxCell id="p3-0"/><mxCell id="p3-1" parent="p3-0"/><mxCell id="p3-n0" value="detection_alert — 로봇 PC (MSI GPU)&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;IF-05 {ns}/inspect_facility 액션 서버 · 요청 때만 카메라 구독&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8E5600;strokeWidth=1.6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#8E5600;" vertex="1" parent="p3-1"><mxGeometry x="308.0" y="93.8" width="701.0" height="1374.0" as="geometry"/></mxCell><mxCell id="p3-n1" value="&lt;div style=&#x27;font-size:8px;color:#8E5600&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;execute(gh): g = gh.request&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;fac = facilities[g.facility_id]&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;expected(x, y) · band 꼭짓점 · view&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;attempt = 1&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F6EAD5;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="759.5" y="137.8" width="203.0" height="69.0" as="geometry"/></mxCell><mxCell id="p3-n2" value="&lt;div style=&#x27;font-size:8px;color:#8E5600&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;subscribe RGB + depth (요청 동안만)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;frames = 3장 모을 때까지 대기 (timeout)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;rgb: CompressedImage · depth: Image 16UC1 [mm]&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F6EAD5;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="730.0" y="260.8" width="262.0" height="57.0" as="geometry"/></mxCell><mxCell id="p3-n3" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;frame = cv2.imdecode(np.frombuffer(msg.data, uint8), IMREAD_COLOR)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if frame is None: 다음 프레임&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;ndarray (H, W, 3) uint8 — test.py 와 같음&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6EAD5;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="334.0" y="362.8" width="466.0" height="46.0" as="geometry"/></mxCell><mxCell id="p3-n4" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;match g.kind:&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;1 EXTINGUISHER · 3 EXIT_LIGHT → YOLO&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;2 SHUTTER → depth (학습 없음)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;4 RACK → OpenCV (학습 없음)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="392.0" y="453.8" width="210.0" height="69.0" as="geometry"/></mxCell><mxCell id="p3-n5" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;r = model.predict(frame, conf=0.25, iou=0.45, imgsz=640)[0]&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;boxes: cls: int · conf: float · xyxy: float[4]&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;3장 중 대상 클래스가 잡힌 장 수로 판단&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6EAD5;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="432.5" y="567.8" width="419.0" height="46.0" as="geometry"/></mxCell><mxCell id="p3-n6" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;대상 클래스 없음 (3장 모두)?&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;depth_roi = depth[expected 위치 투영 ROI]&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if median(depth_roi) &amp;lt; 기대 거리 - 0.2 m: OCCLUDED&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else: NOT_DETECTED&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="692.0" y="712.8" width="276.0" height="69.0" as="geometry"/></mxCell><mxCell id="p3-n7" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;위치 비교&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;(u, v) = 박스 중심 · z = depth[v, u] / 1000&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;(x, y) = tf(camera→map) · pinhole(u, v, z)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if dist((x, y), expected) &amp;gt; pos_tol: POSITION_ANOMALY&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;pos_tol 값은 비전 팀이 정함&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="423.5" y="880.8" width="299.0" height="81.0" as="geometry"/></mxCell><mxCell id="p3-n8" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;정면·노출 충분?&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;front = 박스 가로/세로 비 · 화면 중심 오차&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if not front and attempt &amp;lt; 3:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    publish_feedback(attempt, adjust_yaw, adjust_forward_m)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    attempt += 1 → 새 프레임&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;elif not front: UNCONFIRMED (E6)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="478.0" y="1006.8" width="330.0" height="93.0" as="geometry"/></mxCell><mxCell id="p3-n9" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;세부 판정&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;압력계: 바늘 영역 HSV 녹색 비율 ≥ 기준 → NORMAL 아니면 ABNORMAL&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;유도등: 박스 안 V 채널 평균 ≥ 기준 → NORMAL(점등) 아니면 ABNORMAL&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;기준값은 비전 팀이 시험으로 정함&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="392.5" y="1144.8" width="333.0" height="69.0" as="geometry"/></mxCell><mxCell id="p3-n10" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;셔터 (depth)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;band 4꼭짓점 → 영상 ROI 다각형&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;h = 바닥 평면 대비 높이 (depth → 3D)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if max(h in ROI) ≥ 0.10 m: ABNORMAL else NORMAL&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="452.5" y="628.8" width="267.0" height="69.0" as="geometry"/></mxCell><mxCell id="p3-n11" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;랙 (OpenCV)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;Canny → HoughLinesP → 랙 경계선&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;박스 윤곽(findContours)이 경계선을 넘으면 ABNORMAL&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else NORMAL&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="322.0" y="796.8" width="262.0" height="69.0" as="geometry"/></mxCell><mxCell id="p3-n12" value="&lt;div style=&#x27;font-size:8px;color:#8E5600&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;근거 사진&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;image_ref = cv2.imwrite(원본 경로)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;thumb = resize(긴 변 ≤ 640) → imencode(&#x27;.jpg&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;image = CompressedImage(format=&#x27;jpeg&#x27;, data)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#F6EAD5;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p3-1"><mxGeometry x="431.0" y="1258.8" widt