or=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2985.0" y="882.5" width="173.0" height="70.0" as="geometry"/></mxCell><mxCell id="c338" value="로봇 응답 30초 없음?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="960.5" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c339" value="E3 감지 · 화면 경보 (남은&lt;br&gt;작업 재배정은 추가 기능)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7E4E0;strokeColor=#A33A2B;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="2985.0" y="965.0" width="173.0" height="41.0" as="geometry"/></mxCell><mxCell id="c342" value="배터리 경고?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1028.5" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c343" value="E2 15%면 즉시 Dock (30%&lt;br&gt;인계는 추가 기능)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7E4E0;strokeColor=#A33A2B;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="2985.0" y="1033.0" width="173.0" height="41.0" as="geometry"/></mxCell><mxCell id="c346" value="BLOCKED 결과?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1096.5" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c347" value="E1 재방문 목록에 넣음" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7E4E0;strokeColor=#A33A2B;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="2985.0" y="1108.2" width="173.0" height="26.5" as="geometry"/></mxCell><mxCell id="c350" value="비상정지 버튼?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1164.5" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c351" value="E7 두 로봇 goal 취소" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7E4E0;strokeColor=#A33A2B;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="2985.0" y="1176.2" width="173.0" height="26.5" as="geometry"/></mxCell><mxCell id="c354" value="남은 작업·후보 없음?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1232.5" width="257.0" height="50.0" as="geometry"/></mxCell><mxCell id="c355" value="진행 감시 계속" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2985.0" y="1244.2" width="173.0" height="26.5" as="geometry"/></mxCell><mxCell id="c358" value="S7 두 로봇 DOCK 작업" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1300.5" width="257.0" height="26.5" as="geometry"/></mxCell><mxCell id="c360" value="S8 network_map_engine 최종 계산 →&lt;br&gt;보고서 · 점검표 → DB" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2698.0" y="1345.0" width="257.0" height="41.0" as="geometry"/></mxCell><mxCell id="c362" value="순찰 종료" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F5D7C;fontColor=#17202A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2766.5" y="1404.0" width="120.0" height="30.0" as="geometry"/></mxCell><mxCell id="c364" value="Flask 관제 웹 · SQLite  ·  관제 PC · System Monitor" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#2B6A55;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2682.0" y="1472.0" width="488.0" height="228.0" as="geometry"/></mxCell><mxCell id="c365" value="Flask + Socket.IO: 로그인 · 탭 4개 (네트워크 지도 · 작업·로봇 · CAM(로봇 OAK-D) · 점검 이력)&lt;br&gt;버튼: 순찰 시작 · 비상정지 · 보고서" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2696.0" y="1516.0" width="460.0" height="74.0" as="geometry"/></mxCell><mxCell id="c366" value="SQLite: runs · net_samples · grid_stats · baselines · avoid_cells · facilities · candidates · tasks · inspections · alerts" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2696.0" y="1600.0" width="460.0" height="88.0" as="geometry"/></mxCell><mxCell id="c367" value="브라우저 (팀·관리자)&lt;br&gt;HTTP · WebSocket" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#5A6670;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2100.0" y="1740.0" width="1100.0" height="56.0" as="geometry"/></mxCell><mxCell id="c368" value="통신 구간 · 모두 Wi-Fi turtle08  ·  FastDDS · ROS_DOMAIN_ID 동일 · rmw_fastrtps_cpp" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="2100.0" y="1826.0" width="1100.0" height="328.0" as="geometry"/></mxCell><mxCell id="c369" value="① RPi ↔ 로봇 PC (같은 로봇 짝) · IF-02 · 04 · 06 · 07 · 14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="1870.0" width="290.0" height="57.5" as="geometry"/></mxCell><mxCell id="c370" value="가장 바쁜 구간. 두 로봇 모두 센서 ↑ /scan · /odom · /tf, 구동 ↓ /cmd_vel (Localization·Navigation이 여기에 기대요), dock&lt;br&gt;요청 ↓. 로봇 A만 측정 raw ↑ · 정밀측정 ↓ (IF-02·04), 로봇 B만 설비 점검 때 OAK-D 영상 ↑ (IF-14). 끊기면 주행이 멈추므로&lt;br&gt;RPi는 5 GHz, 시험 때 지연·제어 주기를 먼저 잽니다." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="1870.0" width="772.0" height="57.5" as="geometry"/></mxCell><mxCell id="c371" value="② 로봇 PC ↔ 관제 PC · IF-08–12 · 19" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="1935.5" width="290.0" height="57.5" as="geometry"/></mxCell><mxCell id="c372" value="로봇 A: 측정 샘플 ↑ (1 Hz) · sync ↓ · 로봇 B: 설비 판정 결과 ↑ · keepout 마스크 ↓ (로봇 B만) · 두 로봇: status ↑ (1 Hz) ·&lt;br&gt;execute_task ↓. 끊겨도 받은 작업은 끝까지 — 측정은 버퍼(JSONL)+sync, 판정 결과는 transient_local로 재연결 때 채움 (E4 ·&lt;br&gt;D8)." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="1935.5" width="772.0" height="57.5" as="geometry"/></mxCell><mxCell id="c373" value="③ RPi → 관제 PC 직접 · IF-14" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="2001.0" width="290.0" height="40.0" as="geometry"/></mxCell><mxCell id="c374" value="CAM 탭이 볼 때만 OAK-D 영상을 구독 — 구독자가 없으면 DDS가 보내지 않아요. 맨 위 가로선으로 그렸어요." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="2001.0" width="772.0" height="40.0" as="geometry"/></mxCell><mxCell id="c375" value="④ Discovery Server ×3" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#5A6670;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="2049.0" width="290.0" height="43.0" as="geometry"/></mxCell><mxCell id="c376" value="로봇 A RPi · 로봇 B RPi · 관제 PC가 서버 (10/08) · 로봇 PC A·B는 각자 자기 로봇 서버의 클라이언트 · 관제 PC 서버가 두 로봇&lt;br&gt;서버와 이어져야 로봇 PC ↔ 관제 PC 토픽이 보임 · CLI는 ROS_SUPER_CLIENT=true." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="2049.0" width="772.0" height="43.0" as="geometry"/></mxCell><mxCell id="c377" value="⑤ 핫스팟 · IF-01" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9ECEE;strokeColor=#5A6670;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2114.0" y="2100.0" width="290.0" height="40.0" as="geometry"/></mxCell><mxCell id="c378" value="측정 대상일 뿐 ROS 통신 없음 — RPi가 스캔으로 RSSI만 읽음." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#CBD3D8;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="2414.0" y="2100.0" width="772.0" height="40.0" as="geometry"/></mxCell><mxCell id="c379" value="Localization · Navigation 한 바퀴  ·  로봇 1대 기준 · 로봇 PC ↔ RPi" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F4FB;strokeColor=#5B4BA6;strokeWidth=3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontFamily=Courier New;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20.0" y="1262.0" width="820.0" height="178.0" as="geometry"/></mxCell><mxCell id="c380" value="testbed_v1&lt;br&gt;map_server → /map" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="34.0" y="1308.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c381" value="RPi 센서&lt;br&gt;/scan · /odom · tf&lt;br&gt;Wi-Fi ↑ IF-07" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;fontSize=11;" vertex="1" parent="1"><mxGeometry x="169.7" y="1308.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c383" value="amcl&lt;br&gt;tf map→odom&lt;br&gt;/amcl_pose" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="305.3" y="1308.0" width="113.7" height="66.0" as="geometry"/></mxCell><mxCell id="c3