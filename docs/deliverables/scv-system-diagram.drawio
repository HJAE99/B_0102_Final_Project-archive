=#2B6A55;" vertex="1" parent="p5-1"><mxGeometry x="381.0" y="8.0" width="366.0" height="844.0" as="geometry"/></mxCell><mxCell id="p5-n2" value="PostgreSQL 16 — 쓰는 테이블" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8A6D1F;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#8A6D1F;" vertex="1" parent="p5-1"><mxGeometry x="1027.5" y="25.0" width="319.0" height="601.0" as="geometry"/></mxCell><mxCell id="p5-n3" value="Redis 8" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#8A6D1F;strokeWidth=1.6;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#8A6D1F;" vertex="1" parent="p5-1"><mxGeometry x="1000.0" y="634.0" width="374.0" height="174.0" as="geometry"/></mxCell><mxCell id="p5-n4" value="관제 웹 — 바뀌는 화면&lt;br&gt;&lt;font style=&#x27;font-size:9px&#x27;&gt;WebSocket 으로 받은 채널만 부분 갱신 · 처음 열 때는 SELECT&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FCFCFA;strokeColor=#5B4BA6;strokeWidth=1.6;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=13;fontColor=#5B4BA6;" vertex="1" parent="p5-1"><mxGeometry x="1514.0" y="500.0" width="255.0" height="372.0" as="geometry"/></mxCell><mxCell id="p5-n5" value="&lt;div style=&#x27;font-size:8px;color:#0B7A84&#x27;&gt;survey_buffer&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;IF-08 {ns}/survey/sample&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;scv_msgs/NetSample · 1 Hz × 2대&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="48.5" y="653.5" width="183.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n6" value="&lt;div style=&#x27;font-size:8px;color:#2F5D7C&#x27;&gt;mission_executor&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;IF-12 {ns}/status&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;scv_msgs/RobotStatus · 1 Hz × 2대&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="44.0" y="348.5" width="192.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n7" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;inspection_manager&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;IF-16 /inspection/alerts&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;scv_msgs/Alert&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="48.5" y="470.5" width="183.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n8" value="&lt;div style=&#x27;font-size:8px;color:#8E5600&#x27;&gt;detection_alert&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;IF-19 {ns}/inspect/result&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;scv_msgs/InspectionResult (+ JPEG)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6EAD5;strokeColor=#8E5600;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="40.5" y="531.5" width="199.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n9" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;inspection_manager (관제 API 호출)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;작업·순찰 변화&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;start_run · create_task · assign · finish&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="22.0" y="592.5" width="236.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n10" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;inspection_manager (관제 API 호출)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;후보·재측정&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;Candidate · REINSPECTION 결과 · 결론&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="38.0" y="226.5" width="204.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n11" value="&lt;div style=&#x27;font-size:8px;color:#0B7A84&#x27;&gt;network_map_engine (HTTP POST)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;칸 맵&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;[{ix, iy, center, median, state}]&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E1F1F2;strokeColor=#0B7A84;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="43.0" y="287.5" width="194.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n12" value="&lt;div style=&#x27;font-size:8px;color:#6B7780&#x27;&gt;브라우저&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;사용자 조작&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;로그인 · 버튼 · 확정 이상 확인 · 설정&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF0F2;strokeColor=#6B7780;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="43.0" y="409.5" width="194.0" height="45.0" as="geometry"/></mxCell><mxCell id="p5-n13" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_sample(m: NetSample)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if m.seq != last_seq[rid] + 1 and not m.resent:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    call {ns}/survey/sync(run_id, from_seq=last+1)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;cell_id = SELECT grid_cells WHERE ix, iy (0.5 m)&lt;/div&gt;&lt;div style=&#x27;color:#A33A2B;font-weight:bold&#x27;&gt;net_samples 에 detected 열이 없음 · rssi_dbm NOT NULL&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="422.5" y="756.5" width="283.0" height="81.0" as="geometry"/></mxCell><mxCell id="p5-n14" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_status(m: RobotStatus)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;redis.set(f&#x27;robot:{rid}:state&#x27;, json, ex=30)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;INSERT robot_status_log (1 Hz, PK robot_id·ts)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;키 만료 알림(expired) → E3 · source=&#x27;control&#x27;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="433.0" y="222.5" width="262.0" height="69.0" as="geometry"/></mxCell><mxCell id="p5-n15" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_alert(a: Alert)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;event_uid = f&#x27;{rid}-r{run}-e{n}&#x27; | &#x27;control-&amp;lt;uuid&amp;gt;&#x27;&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;level: 0→info · 1→warn · 2→error&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="420.0" y="489.5" width="288.0" height="57.0" as="geometry"/></mxCell><mxCell id="p5-n16" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_inspection(r: InspectionResult)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;inspection_uid = uuid4()&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;final = normal | abnormal | unconfirmed (verdict 로)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;r.image.data → 파일 scv_media/{object_key} · sha256&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="418.0" y="562.5" width="292.0" height="69.0" as="geometry"/></mxCell><mxCell id="p5-n17" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_task_event(ev)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;start_run → INSERT runs(status=&#x27;running&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;create → INSERT tasks(status=&#x27;PENDING&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;assign → UPDATE status=&#x27;ACTIVE&#x27;, assigned_at&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;result ok → &#x27;DONE&#x27; · fail → scv_fail_task(id, reason)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;run 끝 → UPDATE runs status=&#x27;done&#x27;, ended_at&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="414.5" y="647.5" width="299.0" height="93.0" as="geometry"/></mxCell><mxCell id="p5-n18" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_candidate_event(ev)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;새 후보 → INSERT candidates(status=&#x27;OPEN&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;REINSPECTION 배정 → UPDATE &#x27;REINSPECTING&#x27;, reinspect_task_id&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;재측정 결과 → INSERT precise_measures&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;결론 → UPDATE &#x27;CLOSED&#x27;, outcome · CONFIRMED → INSERT findings&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="395.0" y="52.5" width="338.0" height="81.0" as="geometry"/></mxCell><mxCell id="p5-n19" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_cell_map(cells)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;UPSERT 칸 상태 (섹터 · median · state)&lt;/div&gt;&lt;div style=&#x27;color:#A33A2B;font-weight:bold&#x27;&gt;지금 스키마에 칸 상태 열 없음 → 10/13 추가&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="458.0" y="149.5" width="212.0" height="57.0" as="geometry"/></mxCell><mxCell id="p5-n20" value="&lt;div style=&#x27;font-size:8px;color:#9A6B00&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_user_action(req, session)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;로그인 → SELECT users · bcrypt 비교&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;확정 이상 확인 (admin) → UPDATE findings status=&#x27;acked&#x27;&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;설정 (admin) → UPDATE settings (updated_at 트리거)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;보고서 → 파일 생성 → INSERT reports&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p5-1"><mxGeometry x="414.5" y="307.5" width="299.0" height="81.0" as="geometry"/></mxCell><mxCell id="p5-n21" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 