-size:11px&#x27;&gt;on_robot_status(robot_id, msg: RobotStatus)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;snap = RobotStatusSnapshot(state, battery_percent,&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;   accepting_tasks, task_id, run_id, task_type, progress, warning)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;core.update_robot(robot_id, monotonic(), snap)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2749.8" y="234.0" width="367.0" height="58.0" as="geometry"/></mxCell><mxCell id="p4-n8" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;check_robot_timeouts()  ← timer 1.0 s&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;for rid in core.check_offline(now):&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  # now - last_seen &amp;gt;= 29.0 → online = False&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  publish_alert(ERROR, &#x27;E3&#x27;, rid)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2798.3" y="88.0" width="270.0" height="58.0" as="geometry"/></mxCell><mxCell id="p4-n9" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_start(req, res)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if run_state in {RUNNING, ESTOPPED}:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;    res.success = False   # 이미 진행 중&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2348.3" y="240.0" width="222.0" height="46.0" as="geometry"/></mxCell><mxCell id="p4-n10" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;route_builder.build_survey_routes()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;for zone in zones: _build_scanline_route(polygon, spacing)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  y = min_y + spacing/2, … &amp;lt; max_y (spacing 씩)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  가장자리 교차 x 두 개 → Waypoint(x, y, yaw 0 | π) 번갈아&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;→ list[SurveyRoute(zone_id, waypoints)]&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2342.8" y="343.0" width="325.0" height="70.0" as="geometry"/></mxCell><mxCell id="p4-n11" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;route_builder.build_facility_routes()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;→ list[FacilityRoute(facility_id, (Waypoint(view.x, view.y, view.yaw),))]&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2303.3" y="464.0" width="404.0" height="36.0" as="geometry"/></mxCell><mxCell id="p4-n12" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;run_id = core.start_run(int(time.time()))&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;run_state = RUNNING; tasks.clear()&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2351.8" y="543.0" width="297.0" height="36.0" as="geometry"/></mxCell><mxCell id="p4-n13" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;core.create_task(…) — 계획분&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;task_id = f&#x27;run-{run_id}-survey-{n:03d}&#x27; · SURVEY_SEGMENT&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;task_id = f&#x27;run-{run_id}-facility-{n:03d}&#x27; · FACILITY_CHECK&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;priority = 1 · preferred_robot_id = survey | inspection&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;→ TaskRecord(state=PENDING) · task_order.append&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2312.3" y="622.0" width="330.0" height="70.0" as="geometry"/></mxCell><mxCell id="p4-n14" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;10/12: 섹터·로봇별 작업 목록&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;robot = zone[&#x27;robot&#x27;]  # zones.yaml robot:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;로봇마다: SURVEY → DOCK → (REINSPECTION…) → DOCK&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;           → FACILITY(그 섹터 설비) … → DOCK&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;survey_robot_id · inspection_robot_id 파라미터 제거&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2337.8" y="753.5" width="279.0" height="81.0" as="geometry"/></mxCell><mxCell id="p4-n15" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;dispatch_next_task()  ← timer 0.5 s&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if run_state != RUNNING: return&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if active_goals: return&lt;/div&gt;&lt;div style=&#x27;color:#A33A2B;font-weight:bold&#x27;&gt;작업이 하나라도 돌면 아무것도 안 보냄 → 두 대 동시 불가&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1995.8" y="765.0" width="257.0" height="58.0" as="geometry"/></mxCell><mxCell id="p4-n16" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;10/12: 로봇마다 보내기&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;for rid in robot_ids:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  if active_goals_by_robot[rid]: continue&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  task = core.next_pending_task(rid)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1745.3" y="871.5" width="236.0" height="69.0" as="geometry"/></mxCell><mxCell id="p4-n17" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;task = core.next_pending_task()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if any(state in {ASSIGNED, RUNNING}): None&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;첫 PENDING (task_order 순서)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;None → complete_run_if_ready()&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="2003.8" y="877.0" width="241.0" height="58.0" as="geometry"/></mxCell><mxCell id="p4-n18" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;robot_readiness(rid) → (bool, reason)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;status is None → False · not online → False&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;not accepting_tasks → False  # battery ≤ 30&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;state ∉ {IDLE, DOCKED} → False&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;core.robots[rid].status ← on_robot_status()&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1968.3" y="983.5" width="270.0" height="70.0" as="geometry"/></mxCell><mxCell id="p4-n19" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;10/12: FACILITY 전에 마스크&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if task.type == FACILITY_CHECK and not mask_sent[rid]:&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  cells = SELECT 남은 칸 (그 섹터, 재측정 뒤)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  data = keepout_mask(cells, 0.5, origin, res, w, h)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  # Dock 반경 0.6 m 칸 제외 · 남은 칸 → Alert KEEPOUT&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  pub[rid].publish(OccupancyGrid)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1787.3" y="1826.4" width="304.0" height="93.0" as="geometry"/></mxCell><mxCell id="p4-n20" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;send_task(task_id, rid)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;goal = ExecuteTask.Goal(task_id, run_id, type, priority,&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;   waypoints=[to_pose_stamped(w)], target_ref)&lt;/div&gt;&lt;div style=&#x27;color:#55626C;font-family:sans-serif&#x27;&gt;frame &#x27;map&#x27; · q = (0, 0, sin(yaw/2), cos(yaw/2))&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;core.assign_task → ASSIGNED · send_goal_async&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1945.8" y="1096.5" width="315.0" height="70.0" as="geometry"/></mxCell><mxCell id="p4-n21" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_goal_response(future)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if exception: finish_task(FAILED, &#x27;SEND_FAILED&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if not accepted: finish_task(FAILED, &#x27;GOAL_REJECTED&#x27;)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else: active_goals[task_id] = gh; start_task → RUNNING&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if ESTOPPED or CANCELED: cancel_goal_async()&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1957.3" y="1297.5" width="304.0" height="70.0" as="geometry"/></mxCell><mxCell id="p4-n22" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_task_feedback()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;core.update_task_progress(task_id, fb.progress)&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1975.8" y="1419.5" width="267.0" height="36.0" as="geometry"/></mxCell><mxCell id="p4-n23" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_task_result(future) → finish_task(ok, reason)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;ok → SUCCEEDED, progress 1.0&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;reason.upper() == &#x27;BLOCKED&#x27; → BLOCKED  (E1 WARN)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else → FAILED  (TASK_FAILED ERROR)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;REINSPECTION ok → Alert &#x27;REINSPECTION_DONE&#x27;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1916.8" y="1484.5" width="345.0" height="70.0" as="geometry"/></mxCell><mxCell id="p4-n24" value="&lt;div style=&#x27;font-size:8px;color:#2B6A55&#x27;&gt;설계 · 아직 코드 없음&lt;/div&gt;&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;10/12: 재측정 결과 → DB&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;median, n = result.rssi_median, result.n_samples  # v0.2.10&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;INSERT precise_measures · UPDATE 칸 상태&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if n == 0 or median &amp;lt; −72: 남음 → Alert KEEPOUT (사람 확인)&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;else: 해제&lt;/div&gt;&lt;/div&gt;" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1641.3" y="1597.5" width="330.0" height="81.0" as="geometry"/></mxCell><mxCell id="p4-n25" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;complete_run_if_ready()&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if RUNNING and all_tasks_terminal():&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  # 모든 task ∈ {SUCCEEDED, BLOCKED, FAILED}&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  run_state = COMPLETED → Alert &#x27;RUN_COMPLETED&#x27;&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1993.8" y="1609.0" width="267.0" height="58.0" as="geometry"/></mxCell><mxCell id="p4-n26" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_candidate(msg: Candidate)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if source != SOURCE_NETWORK: return&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if run_id != core.run_id or IDLE: return&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if candidate_id in seen: return&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF1C9;strokeColor=#9A6B00;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1696.8" y="234.0" width="231.0" height="58.0" as="geometry"/></mxCell><mxCell id="p4-n27" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;core.reopen_run(); create_task(&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  f&#x27;run-{id}-reinspect-{cid}&#x27;, REINSPECTION, priority=10,&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  waypoints=(Waypoint(msg.x, msg.y, msg.yaw),),&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;  preferred_robot_id = survey_robot_id)&lt;/div&gt;&lt;div style=&#x27;color:#A33A2B;font-weight:bold&#x27;&gt;10/12: 그 칸이 속한 섹터의 로봇으로&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=6;overflow=fill;" vertex="1" parent="p4-1"><mxGeometry x="1696.3" y="343.0" width="320.0" height="70.0" as="geometry"/></mxCell><mxCell id="p4-n28" value="&lt;div style=&#x27;font-family:monospace;font-weight:bold;font-size:11px&#x27;&gt;on_inspection_result(msg: InspectionResult)&lt;/div&gt;&lt;div style=&#x27;font-size:9px&#x27;&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;if run_id != core.run_id or 중복 key: return&lt;/div&gt;&lt;div style=&#x27;font-family:monospace&#x27;&gt;NORMAL → Alert INFO &#x27;INSPECTION_NORMAL&#x27;&lt;/div&gt;&lt;div