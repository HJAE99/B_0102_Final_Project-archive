ontSize=12;fillColor=#F1F3F4;fontColor=#17202A;fontFamily=Helvetica;" vertex="1" parent="rr83"><mxGeometry x="950" y="0" width="150" height="44" as="geometry"><mxRectangle width="150" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc90" value="" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=8;overflow=visible;whiteSpace=nowrap;html=1;fontSize=12;fillColor=#F1F3F4;fontColor=#17202A;fontFamily=Helvetica;" vertex="1" parent="rr83"><mxGeometry x="1100" y="0" width="420" height="44" as="geometry"><mxRectangle width="420" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rr91" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;top=0;left=0;right=0;bottom=0;html=1;strokeColor=#A33A2B;" vertex="1" parent="rt2"><mxGeometry x="0" y="484" width="1520" height="44" as="geometry"></mxGeometry></mxCell><mxCell id="rc92" value="session:{token}" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Courier New;" vertex="1" parent="rr91"><mxGeometry x="0" y="0" width="200" height="44" as="geometry"><mxRectangle width="200" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc93" value="HASH" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr91"><mxGeometry x="200" y="0" width="110" height="44" as="geometry"><mxRectangle width="110" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc94" value="TTL 8 h" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr91"><mxGeometry x="310" y="0" width="110" height="44" as="geometry"><mxRectangle width="110" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc95" value="api" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr91"><mxGeometry x="420" y="0" width="300" height="44" as="geometry"><mxRectangle width="300" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc96" value="api" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr91"><mxGeometry x="720" y="0" width="230" height="44" as="geometry"><mxRectangle width="230" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc97" value="users" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr91"><mxGeometry x="950" y="0" width="150" height="44" as="geometry"><mxRectangle width="150" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc98" value="server page 로그인 세션" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="rr91"><mxGeometry x="1100" y="0" width="420" height="44" as="geometry"><mxRectangle width="420" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="x99" value="&lt;b&gt;저장 원칙&lt;/b&gt;&lt;br&gt;• 보고서·KPI·재검증 근거 → PostgreSQL에 반드시 저장. Redis에만 있는 데이터는 만들지 않는다&lt;br&gt;• Redis가 비어도 PostgreSQL과 ROS 토픽(status 1 Hz 등)에서 몇 초 안에 다시 채워진다&lt;br&gt;• 모든 휘발 키에 TTL · maxmemory 256mb · volatile-lru&lt;br&gt;• 포트는 127.0.0.1에만 — 제어 PC나 Wi-Fi 쪽에서는 접속하지 않음&lt;br&gt;• 명령(순찰 시작·전체 정지)은 Redis를 거치지 않고 ROS 서비스 호출 · 명령 이력·배정 락·알림 채널 없음" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA7B0;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="688" width="740" height="170" as="geometry"></mxGeometry></mxCell><mxCell id="x100" value="&lt;b&gt;제어 PC에 Redis를 두지 않는 이유&lt;/b&gt;&lt;br&gt;• 알림 5 s(BR-T11)·응답 없음 30 s(SR-11)·비상정지는 지연 전달 불가&lt;br&gt;• 표본 1–2 Hz·status 1 Hz라 줄일 트래픽이 거의 없음 (큰 것은 영상인데 관제 PC로 안 보냄)&lt;br&gt;• 제어 PC↔관제 PC 전송은 ROS 2 QoS가 이미 담당 — 계층을 하나 더 두면 경로가 둘이 됨&lt;br&gt;• 끊김 대비는 제어 PC의 JSONL 버퍼(survey_buffer)로 충분 · 재연결 때 마지막 seq는 PostgreSQL에서 조회" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7FBFB;strokeColor=#0B7A84;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="688" width="740" height="170" as="geometry"></mxGeometry></mxCell><mxCell id="x101" value="&lt;b&gt;대표 흐름&lt;/b&gt;&lt;br&gt;순찰 시작 → api → ros-bridge → /inspection/start_run → 응답 run_id → &lt;b&gt;run:current&lt;/b&gt;&lt;br&gt;{ns}/status → ros-bridge → &lt;b&gt;robot:{rid}:state&lt;/b&gt;(30 s) → api → 화면&lt;br&gt;표본 수신 → &lt;b&gt;live:{run}:cells&lt;/b&gt; 증분 → 실시간 히트맵&lt;br&gt;{ns}/events(사건·CANDIDATE·CONFIRMED…) → robot_events + &lt;b&gt;stream:events&lt;/b&gt; → 이벤트 화면&lt;br&gt;LOCAL_ESTOP·전체 정지 성공 → &lt;b&gt;robot:{rid}:estop&lt;/b&gt; → task 전송 차단" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#A33A2B;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1560" y="688" width="740" height="170" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="docker" name="3. Docker 구조도"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value='&lt;b style="font-size:24px"&gt;SCV 운영 DB 구조도 — ③ Docker 구조도 · 기기 배치 · 데이터 경로&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#55626C"&gt;Docker Compose는 관제 PC에만 (project: scv) · 제어 PC는 ROS 노드 + 로컬 백엔드 + JSONL 버퍼 · Redis는 관제 PC에만 · 2차 (2026-10-11)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1700" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="v2" value="&lt;b&gt;로봇 robot3 · TurtleBot4&lt;/b&gt; /robot3&lt;br&gt;turtlebot4 bringup (Create 3·LiDAR)&lt;br&gt;&lt;b&gt;rssi_scanner&lt;/b&gt; (핫스팟 RSSI 1–2 Hz)&lt;br&gt;OAK-D Pro (압축 영상 토픽)&lt;br&gt;Discovery Server (robot3)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="270" height="130" as="geometry"></mxGeometry></mxCell><mxCell id="v3" value="&lt;b&gt;로봇 robot4 · TurtleBot4&lt;/b&gt; /robot4&lt;br&gt;robot3과 같은 구성" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="270" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="f4" value="&lt;b&gt;PC 2 · robot3의 제어 PC (MSI GPU)&lt;/b&gt; — robot3과 짝 · Docker 없음(ROS 노드)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#2F5D7C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="580" height="600" as="geometry"></mxGeometry></mxCell><mxCell id="v5" value="&lt;b&gt;Nav2 · AMCL&lt;/b&gt;&lt;br&gt;지도 = robot_map_path&lt;br&gt;(파일명 확인 · 다르면 LoadMap)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ECE8F7;strokeColor=#5B4BA6;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="180" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v6" value="&lt;b&gt;mission_executor&lt;/b&gt;&lt;br&gt;execute_task 수행 · 자세 보정&lt;br&gt;{ns}/status 1 Hz · {ns}/events(사건)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="180" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v7" value="&lt;b&gt;survey_buffer&lt;/b&gt;&lt;br&gt;RSSI + AMCL 위치 + seq · 정지 30 s 요약&lt;br&gt;칸 중앙값 &amp;lt; −72 → &lt;b&gt;CANDIDATE&lt;/b&gt;&lt;br&gt;재검증 중앙값 → &lt;b&gt;CONFIRMED·CLEARED&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E7F4F3;strokeColor=#0B7A84;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="290" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v8" value="&lt;b&gt;detection_alert (YOLO)&lt;/b&gt;&lt;br&gt;판정 · 사진 저장 → HTTP 업로드&lt;br&gt;NORMAL 아님 → &lt;b&gt;CANDIDATE&lt;/b&gt;&lt;br&gt;재촬영 → &lt;b&gt;CONFIRMED·CLEARED&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#8E5600;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="290" width="250" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v9" value="&lt;b&gt;client page 로컬 백엔드&lt;/b&gt; (FastAPI :8080 · rclpy)&lt;br&gt;카메라 MJPEG (보는 동안만 구독) · YOLO 오버레이&lt;br&gt;이 로봇 정지 → mission_executor (LOCAL_ESTOP)&lt;br&gt;상태 · 버퍼 적체 · 지도 파일명 표시" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="400" width="530" height="100" as="geometry"></mxGeometry></mxCell><mxCell id="v10" value="&lt;b&gt;로컬 디스크&lt;/b&gt; /opt/scv&lt;br&gt;maps/ (robot_map_path) · buffer/*.jsonl (끊김 대비) · photos/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5A6670;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="520" width="530" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="v11" value="&lt;b&gt;client page&lt;/b&gt; — robot3의 제어 PC 브라우저&lt;br&gt;카메라 · 로컬 정지 · 상태" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="620" width="530" height="80" as="geometry"></mxGeometry></mxCell><mxCell id="f12" value="&lt;b&gt;PC 3 · robot4의 제어 PC (MSI GPU)&lt;/b&gt; — robot3의 제어 PC와 같은 구성 (/robot4)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F9FC;strokeColor=#2F5D7C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;dashed=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="800" width="580" height="110" as="geometry"></mxGeometry></mxCell><mxCell id="v13" value="&lt;b&gt;Wi-Fi turtle08&lt;/b&gt;&lt;br&gt;FastDDS&lt;br&gt;Discovery&lt;br&gt;Server ×3" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF5F6;strokeColor=#0B7A84;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;align=center;spacingLeft=0;" vertex="1" parent="1"><mxGeometry x="950" y="130" width="140" height="780" as="geometry"></mxGeometry></mxCell><mxCell id="f14" value="&lt;b&gt;PC 1 · 관제 PC (Victus)&lt;/b&gt; — Docker Engine · docker compose (project: scv)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FAFAF7;strokeColor=#17202A;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="1270" height="780" as="geometry"></mxGeometry></mxCell><mxCell id="v15" value="&lt;b&gt;scv-ros-bridge&lt;/b&gt; (원문 ros_bridge)&lt;br&gt;ROS 2 Jazzy · host 네트워크 · ipc host&lt;br&gt;구독: survey/sample · status · events · inspect/result&lt;br&gt;(robot, seq) 중복 제거 → 1 s 일괄 INSERT&lt;br&gt;robot_events INSERT + stream:events XADD&lt;br&gt;재연결 시 max(seq) 조회 → survey/sync&lt;br&gt;HTTP 127.0.0.1:8100 → start_run·estop 서비스 호출&lt;br&gt;E8 쓰기 실패 → 메모리 큐·재시도" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="170" width="320" height="200" as="geometry"></mxGeometry></mxCell><mxCell id="v16" value="&lt;b&gt;scv-api&lt;/b&gt; · FastAPI :8000 · network_mode: host&lt;br&gt;REST + WebSocket · SQLAlchemy · Alembic&lt;br&gt;사진 업로드 수신 → scv_media&lt;br&gt;순찰 시작·전체 정지 → ros-bridge HTTP (응답 확인)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="410" width="320" height="130" as="geometry"></mxGeometry></mxCell><mxCell id="v17" value="&lt;b&gt;scv-web&lt;/b&gt; · nginx :80&lt;br&gt;server page (React 빌드)&lt;br&gt;/api · /ws → scv-api" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DFEEE7;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="580" width="320" height="100" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="&lt;b&gt;scv-postgres&lt;/b&gt; · postgres:16&lt;br&gt;127.0.0.1:5432 · volume scv_pgdata&lt;br&gt;스키마 = ① 탭" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1F7;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="180" width="300" height="100" as="geometry"></mxGeometry></mxCell><mxCell id="v19" value="&lt;b&gt;scv-redis&lt;/b&gt; · redis:8&lt;br&gt;127.0.0.1:6379 · volume scv_redisdata&lt;br&gt;키 = ② 탭 · &lt;b&gt;관제 PC에만&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBECE9;strokeColor=#A33A2B;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="400" width="300" height="100" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="&lt;b&gt;volume scv_media&lt;/b&gt;&lt;br&gt;증거 사진 · 보고서 파일" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBF3E4;strokeColor=#8E5600;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1520" y="580" width="300" height="80" as="geometry"></mxGeometry></mxCell><mxCell id="v21" value="&lt;b&gt;관제 PC ROS 노드&lt;/b&gt; (호스트 또는 같은 이미지)&lt;br&gt;inspection_manager — run·task 생성(역할 고정), start_run·estop 서비스,&lt;br&gt;&amp;nbsp;&amp;nbsp;CANDIDATE → REINSPECTION task, 결론 → candidates·findings&lt;br&gt;network_map_engine — 순찰 후 보고서용 통계·기준선&lt;br&gt;PG 읽기/쓰기 (ros-bridge 거치지 않음) · 카메라 구독 안 함" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EBF2;strokeColor=#2F5D7C;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1870" y="330" width="500" height="150" as="geometry"></mxGeometry></mxCell><mxCell id="v22" value="&lt;b&gt;백업&lt;/b&gt; pg_dump 매일 + 순찰 종료 후&lt;br&gt;docker compose down -v 금지" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5A6670;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1870" y="180" width="490" height="90" as="geometry"></mxGeometry></mxCell><mxCell id="v23" value="&lt;b&gt;dev 프로필 (선택)&lt;/b&gt; pgAdmin · RedisInsight" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F1F3F4;strokeColor=#5A6670;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1870" y="580" width="490" height="60" as="geometry"></mxGeometry></mxCell><mxCell id="v24" value="&lt;b&gt;server page&lt;/b&gt; — 관제 PC 브라우저 (admin · viewer)&lt;br&gt;네트워크 · 작업·로봇 · 이벤트 · 점검 · 보고서 · 설정" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6A55;fontSize=12;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1150" y="760" width="670" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="a25" value="RSSI raw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#B5651D;strokeWidth=2;fontColor=#B5651D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.55;entryX=0;entryY=0.5;fontFamily=Helvetica;" edge="1" parent="1" source="v2" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a26" value="OAK-D (점검·client page 볼 때만)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#B5651D;strokeWidth=2;fontColor=#B5651D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.85;entryX=0.5;entryY=1;fontFamily=Helvetica;" edge="1" parent="1" source="v2" target="v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="300"/><mxPoint x="330" y="392"/><mxPoint x="775" y="392"/></Array></mxGeometry></mxCell><mxCell id="a27" value="/scan·odom·tf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#5B4BA6;strokeWidth=2;fontColor=#5B4BA6;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.2;entryX=0;entryY=0.4;fontFamily=Helvetica;" edge="1" parent="1" source="v2" target="v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#B5651D;strokeWidth=2;fontColor=#B5651D;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;ex