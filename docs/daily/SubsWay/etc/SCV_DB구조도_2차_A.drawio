="0" width="34" height="22" as="geometry"><mxRectangle width="34" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="c637" value="generated_at" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Courier New;" vertex="1" parent="r635"><mxGeometry x="34" y="0" width="182" height="22" as="geometry"><mxRectangle width="182" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="c638" value="TIMESTAMPTZ" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=4;overflow=hidden;whiteSpace=wrap;html=1;fontSize=10;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="r635"><mxGeometry x="216" y="0" width="212" height="22" as="geometry"><mxRectangle width="212" height="22" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="x656" value='&lt;b style="font-size:24px"&gt;SCV 운영 DB 구조도 — ① PostgreSQL 스키마 (영구 저장 · 관제 PC)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#55626C"&gt;테이블 20개 (★ 9개 = 원문 SR-16 테이블) · 6개 도메인 · 머리의 색 띠 = 데이터 경로 · 2차 (2026-10-11)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1700" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="x657" value="&lt;b&gt;읽는 법&lt;/b&gt;&lt;br&gt;&lt;font color='#B8860B'&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/font&gt; 기본키 · &lt;font color='#2F5D7C'&gt;&lt;b&gt;FK&lt;/b&gt;&lt;/font&gt; 외래키 · &lt;font color='#8B3A62'&gt;&lt;b&gt;PK FK&lt;/b&gt;&lt;/font&gt; 복합 기본키이자 외래키 · &lt;font color='#2B6A55'&gt;&lt;b&gt;UK&lt;/b&gt;&lt;/font&gt; 유일키 · 선 끝: 까마귀발 = 여러 개, 세로선 = 반드시 1개, 원 = NULL 허용&lt;br&gt;&lt;font color='#A33A2B'&gt;&lt;b&gt;★&lt;/b&gt;&lt;/font&gt; 원문 SR-16 테이블 이름 그대로 · &lt;b&gt;robots · users · aps&lt;/b&gt; 참조선은 생략(행의 → 표기)&lt;br&gt;&lt;b&gt;데이터 경로&lt;/b&gt; &lt;span style=&quot;background-color:#5A6670;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;관제 PC에서 생성&amp;nbsp;&lt;/span&gt; server page·관제 PC 노드가 만듦 &amp;nbsp; &lt;span style=&quot;background-color:#2B6A55;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;제어 PC 통과 · 가공 없이 관제 PC로&amp;nbsp;&lt;/span&gt; 제어 PC 노드가 발행, 내용은 그대로 &amp;nbsp; &lt;span style=&quot;background-color:#B5651D;color:#FFFFFF;font-size:10px;font-weight:bold;&quot;&gt;&amp;nbsp;제어 PC에서 가공 후 관제 PC로&amp;nbsp;&lt;/span&gt; 로봇 원천을 제어 PC가 가공 · 제어 PC를 지나지 않고 관제 PC로 가는 데이터는 없음&lt;br&gt;시각은 TIMESTAMPTZ(UTC 저장·KST 표시) · x/y는 map 좌표(m)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA7B0;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1780" y="24" width="1100" height="150" as="geometry"></mxGeometry></mxCell><mxCell id="x658" value="&lt;b&gt;무결성 규칙 (DB에서 강제)&lt;/b&gt;&lt;br&gt;① findings는 candidates.outcome='CONFIRMED'이고 task_id = candidates.reinspect_task_id(REINSPECTION)일 때만 INSERT — 재검증 없는 확정 0건 (BR-T06·R02)&lt;br&gt;② 재검증 task의 robot_id ≠ candidates.detected_by (역할 고정: 1차 순찰 로봇 ≠ 재검증 로봇, C4) · candidates UK(run_id, ref) — 같은 칸·설비 후보는 하나&lt;br&gt;③ net_samples PK (robot_id, run_id, seq) + ON CONFLICT DO NOTHING → 재전송 중복 0 (SR-03)&lt;br&gt;④ pose_ok=false 표본·보간 칸은 통계·판정 제외 (E5, BR-R02)&lt;br&gt;⑤ 작업의 robot_map_path 파일이 없거나 지금 띄운 지도와 파일명이 다르면 작업 거절 MAP_MISMATCH (지도 파일 덮어쓰기 금지)&lt;br&gt;⑥ task가 FAILED면 남은 task는 CANCELED, run은 aborted — 인계 없이 처음부터 새 run" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8F6;strokeColor=#A33A2B;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2920" y="24" width="1040" height="170" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="redis" name="2. Redis 스키마"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2340" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="x1" value='&lt;b style="font-size:24px"&gt;SCV 운영 DB 구조도 — ② Redis 스키마 (비영구 · 실시간 · 관제 PC에만)&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#55626C"&gt;redis:8 컨테이너 · 127.0.0.1:6379 · AOF everysec · maxmemory 256mb volatile-lru · 키 8종 · 명령은 Redis를 거치지 않음 · 2차 (2026-10-11)&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1700" height="70" as="geometry"></mxGeometry></mxCell><mxCell id="rt2" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=1;html=1;fillColor=#FFFFFF;strokeColor=#A33A2B;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1520" height="528" as="geometry"></mxGeometry></mxCell><mxCell id="rr3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;top=0;left=0;right=0;bottom=0;html=1;strokeColor=#A33A2B;" vertex="1" parent="rt2"><mxGeometry x="0" y="0" width="1520" height="44" as="geometry"></mxGeometry></mxCell><mxCell id="rc4" value="키" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;fillColor=#F2CFC8;fontFamily=Helvetica;" vertex="1" parent="rr3"><mxGeometry x="0" y="0" width="200" height="44" as="geometry"><mxRectangle width="200" height="44" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="rc5" value="자료형" style="shape=partialRectangle;connectable=0;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;verticalAlign=middle;html=1;fontSize=11;fontStyle=1;fillColor=#F2CFC8;fontFamily=Helvetica;" vertex="1" parent="rr3"><mxGeometry x="200" y="0" width="110" heig