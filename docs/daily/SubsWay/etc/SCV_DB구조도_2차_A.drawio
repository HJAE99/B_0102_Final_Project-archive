olor=#2B6A55;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="v11" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a39" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2F5D7C;strokeWidth=2;fontColor=#2F5D7C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.4;fontFamily=Helvetica;" edge="1" parent="1" source="v15" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a40" value="HSET · XADD stream:events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#A33A2B;strokeWidth=2;fontColor=#A33A2B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.8;entryX=0;entryY=0.2;fontFamily=Helvetica;" edge="1" parent="1" source="v15" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a41" value="SELECT · ack" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2F5D7C;strokeWidth=2;fontColor=#2F5D7C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.2;entryX=0;entryY=0.85;fontFamily=Helvetica;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a42" value="XREAD stream:events · 세션" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#A33A2B;strokeWidth=2;fontColor=#A33A2B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.6;entryX=0;entryY=0.75;fontFamily=Helvetica;" edge="1" parent="1" source="v16" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#8E5600;strokeWidth=2;fontColor=#8E5600;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=1;exitY=0.95;entryX=0;entryY=0.4;fontFamily=Helvetica;" edge="1" parent="1" source="v16" target="v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a44" value="/api · /ws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2B6A55;strokeWidth=2;fontColor=#2B6A55;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;fontFamily=Helvetica;" edge="1" parent="1" source="v17" target="v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a45" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#17202A;strokeWidth=2;fontColor=#17202A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=0.25;exitY=0;entryX=0.5;entryY=1;fontFamily=Helvetica;" edge="1" parent="1" source="v24" target="v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a46" value="run·task·후보·확정·통계" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2F5D7C;strokeWidth=2;fontColor=#2F5D7C;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.05;entryX=1;entryY=0.75;fontFamily=Helvetica;" edge="1" parent="1" source="v21" target="v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a47" value="run:current · progress" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#A33A2B;strokeWidth=2;fontColor=#A33A2B;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0;exitY=0.8;entryX=1;entryY=0.5;fontFamily=Helvetica;" edge="1" parent="1" source="v21" target="v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a48" value="명령 HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#2B6A55;strokeWidth=2;fontColor=#2B6A55;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;exitX=0.15;exitY=0;entryX=0.15;entryY=1;fontFamily=Helvetica;" edge="1" parent="1" source="v16" target="v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a49" value="ROS 서비스 start_run · estop" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#5A6670;strokeWidth=2;fontColor=#5A6670;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.95;entryX=0;entryY=0.2;fontFamily=Helvetica;" edge="1" parent="1" source="v15" target="v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a50" value="pg_dump" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#5A6670;strokeWidth=2;fontColor=#5A6670;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;fontFamily=Helvetica;" edge="1" parent="1" source="v18" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x51" value="&lt;b&gt;선 색 = 데이터 경로&lt;/b&gt; &amp;nbsp; &lt;font color='#B5651D'&gt;&lt;b&gt;━ 제어 PC에서 가공 후 관제 PC로&lt;/b&gt;&lt;/font&gt; (net_samples · precise_measures · inspections · media · 후보·확정 이벤트 → candidates · findings) &amp;nbsp; &lt;font color='#2B6A55'&gt;&lt;b&gt;━ 제어 PC 통과 · 가공 없이 관제 PC로&lt;/b&gt;&lt;/font&gt; (tasks 상태 · robot_status_log · robot_events) &amp;nbsp; &lt;font color='#5A6670'&gt;&lt;b&gt;━ 관제 PC → 제어 PC&lt;/b&gt;&lt;/font&gt; 작업·판정 기준·정지 지시&lt;br&gt;• 제어 PC를 지나지 않고 관제 PC로 가는 데이터는 없음 — 관제 PC가 카메라를 구독하지 않으므로 로봇 → 관제 PC 경로가 사라짐. 상태·이벤트도 제어 PC의 mission_executor가 발행&lt;br&gt;• 이상 후보는 1차 순찰 로봇의 제어 PC가 자기 측정값·판정으로, 확정·해제는 재검증 로봇의 제어 PC가 정지 측정·재촬영으로 판단해 {ns}/events로 알림 · 기준선·두 로봇 병합 통계는 순찰 후 보고서에서만 확인&lt;br&gt;• 명령: server page → api → ros-bridge HTTP → ROS 서비스(start_run · estop) → 응답으로 성공·실패 확인 · task가 실패하면 인계 없이 run aborted → 처음부터 새 run&lt;br&gt;• 끊김(E4·D8): 제어 PC는 받은 작업을 끝내고, 표본·이벤트는 JSONL, 판정은 transient_local + 디스크 사진으로 보관 → 재연결 때 전송&lt;br&gt;• 지도: 관제 PC는 파일 대신 robot_map_path(파일명이 같으면 같은 지도)를 작업에 실어 보냄 · 관제 PC는 표시용 PNG와 resolution·origin만 보유 · 순찰 경로는 inspection_manager가 지도 빈 공간에서 자동 생성해 tasks.waypoints에 저장 · 고정 USB 웹캠(SR-22)은 이번 구조에서 제외(결정 필요)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7FBFB;strokeColor=#0B7A84;align=left;verticalAlign=top;spacing=12;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="2350" height="180" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>