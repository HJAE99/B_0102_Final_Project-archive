# IF-05 {ns}/inspect_facility · mission_executor → detection_alert (둘 다 로봇 PC)
string task_id
uint32 run_id                   # 순찰 회차. mission_executor 가 ExecuteTask.Goal.run_id 를 그대로 넣고, detection_alert 가 InspectionResult.run_id 로 씀 (10/12)
string facility_id              # facilities.yaml
uint8  kind                     # InspectionResult.KIND_*
---
uint8  verdict                  # InspectionResult.NORMAL … UNCONFIRMED
string detail
string image_ref
---
uint8   attempt                 # 1–3
float32 adjust_yaw              # 자세 보정 요청 [rad] (0 이면 없음)
float32 adjust_forward_m        # 앞(+)·뒤(−) [m]
string  note
